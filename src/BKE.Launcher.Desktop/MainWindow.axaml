<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BKE.Launcher.Presentation"
        xmlns:contracts="using:BKE.Launcher.Contracts"
        x:Class="BKE.Launcher.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BKE"
        Width="1120"
        Height="740"
        MinWidth="860"
        MinHeight="580">
  <Grid>
    <Border IsVisible="{Binding ShowLoginPage}"
            Classes="surface"
            Width="680"
            Padding="34"
            CornerRadius="18"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <ScrollViewer MaxHeight="650"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <TextBlock Text="BKE"
                     Classes="brand"
                     FontSize="38"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Your software. One account. One place."
                     Classes="muted"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Message}"
                     Classes="muted"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />

          <StackPanel IsVisible="{Binding ShowSignInForm}" Spacing="14">
            <TextBlock Text="Email"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0" />
            <TextBox Text="{Binding Email, Mode=TwoWay}"
                     Watermark="you@example.com" />

            <TextBlock Text="Password"
                       FontWeight="SemiBold" />
            <TextBox Text="{Binding Password, Mode=TwoWay}"
                     PasswordChar="●" />

            <StackPanel IsVisible="{Binding HasAccountChoices}" Spacing="6">
              <TextBlock Text="Account" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding AvailableAccounts}"
                        SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="contracts:NativeBkeAccountChoice">
                    <TextBlock Text="{Binding AccountDisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <Button Content="Sign in with BKE"
                    Classes="primary"
                    HorizontalAlignment="Stretch"
                    Click="NativeSignIn" />

            <StackPanel IsVisible="{Binding ShowNativeMfaChallenge}" Spacing="8">
              <TextBlock Text="Multi-factor verification"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding NativeMfaMessage}"
                         Classes="muted"
                         TextWrapping="Wrap"
                         TextAlignment="Center" />
              <TextBlock Text="{Binding NativeMfaReference}"
                         FontWeight="SemiBold"
                         TextAlignment="Center" />
              <TextBox Text="{Binding NativeMfaCode, Mode=TwoWay}"
                       Watermark="Verification code" />
              <Button Content="Verify and sign in"
                      Classes="primary"
                      IsEnabled="{Binding CanVerifyNativeMfa}"
                      Click="VerifyNativeMfa" />
            </StackPanel>

            <Button Content="Create a BKE account"
                    HorizontalAlignment="Stretch"
                    Click="OpenRegistration" />
            <Button Content="Forgot password?"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding CanRequestPasswordReset}"
                    Click="RequestPasswordReset" />
            <TextBlock Text="{Binding PasswordResetMessage}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
          </StackPanel>

          <StackPanel IsVisible="{Binding ShowRegistration}" Spacing="14">
            <TextBlock Text="Create your BKE account"
                       FontSize="24"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding RegistrationMessage}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />

            <StackPanel IsVisible="{Binding ShowRegistrationEntry}" Spacing="12">
              <TextBlock Text="Name" FontWeight="SemiBold" />
              <TextBox Text="{Binding RegistrationName, Mode=TwoWay}"
                       Watermark="Your name" />
              <TextBlock Text="Email" FontWeight="SemiBold" />
              <TextBox Text="{Binding RegistrationEmail, Mode=TwoWay}"
                       Watermark="you@example.com" />
              <TextBlock Text="Password" FontWeight="SemiBold" />
              <TextBox Text="{Binding RegistrationPassword, Mode=TwoWay}"
                       PasswordChar="●" />

              <TextBlock Text="Current legal documents"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Margin="0,8,0,0" />
              <TextBlock Text="These exact published versions come from BKE Digital Solutions. Review both before accepting."
                         Classes="muted"
                         TextWrapping="Wrap" />

              <ItemsControl ItemsSource="{Binding RegistrationLegalDocuments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RegistrationLegalDocumentViewModel">
                    <Border Classes="content-card"
                            Padding="14"
                            Margin="0,0,0,10">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   FontSize="16" />
                        <TextBlock Text="{Binding VersionLabel}"
                                   Classes="muted" />
                        <TextBox Text="{Binding ContentMarkdown}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 MaxHeight="190"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <CheckBox IsChecked="{Binding IsAccepted, Mode=TwoWay}"
                                  Content="I have reviewed and accept this exact published version." />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button Content="Create account"
                      Classes="primary"
                      IsEnabled="{Binding CanCreateAccount}"
                      Click="CreateNativeAccount" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowRegistrationVerification}" Spacing="10">
              <TextBlock Text="Verify your email"
                         FontSize="18"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{Binding RegistrationEmail}"
                         FontWeight="SemiBold"
                         TextAlignment="Center" />
              <TextBox Text="{Binding RegistrationCode, Mode=TwoWay}"
                       Watermark="8-character verification code" />
              <Button Content="Verify email"
                      Classes="primary"
                      IsEnabled="{Binding CanVerifyRegistrationEmail}"
                      Click="VerifyRegistrationEmail" />
              <Button Content="Resend verification code"
                      IsEnabled="{Binding CanResendRegistrationEmail}"
                      Click="ResendRegistrationVerification" />
            </StackPanel>

            <Button Content="Back to sign in"
                    HorizontalAlignment="Stretch"
                    Click="CancelRegistration" />
          </StackPanel>

          <Border IsVisible="{Binding HasMfaRecoveryCodes}"
                  Classes="content-card"
                  Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Save your recovery codes"
                         FontWeight="SemiBold" />
              <TextBlock Text="These codes are shown only from the authoritative MFA operation. Save them somewhere secure before dismissing this message."
                         Classes="muted"
                         TextWrapping="Wrap" />
              <TextBox Text="{Binding AccountMfaRecoveryCodes}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       MinHeight="100" />
              <Button Content="I saved these codes"
                      Click="DismissMfaRecoveryCodes" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid IsVisible="{Binding ShowAuthenticatedShell}"
          RowDefinitions="Auto,*"
          Margin="28">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
      <StackPanel Spacing="4">
        <TextBlock Text="BKE" Classes="brand" />
        <TextBlock Text="All your BKE software, in one place." Classes="muted" />
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="10">
        <Button Content="Account"
                Click="OpenAccount" />
        <Border Classes="status-pill" Padding="14,8">
          <TextBlock Text="{Binding SessionStatus}"
                     FontSize="11"
                     FontWeight="SemiBold" />
        </Border>
      </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="24">
        <Border Width="360"
                Classes="surface"
                Padding="22"
                IsVisible="{Binding ShowAccountSurface}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
              <TextBlock Text="Account" Classes="section-title" />
              <TextBlock Text="{Binding AccountDisplay}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AccountTypeLabel}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Opacity="0.72" />
              <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" />

              <Button Content="Refresh account status" Click="RefreshStatus" />
              <Button Content="Switch BKE account"
                      IsEnabled="{Binding CanSwitchAccount}"
                      Click="SwitchAccount" />
              <TextBlock Text="{Binding SwitchAccountHint}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Opacity="0.68" />
              <Button Content="Sign out on this machine" Click="Logout" />

              <Border IsVisible="{Binding ShowOrganizationCreateSection}"
                      Classes="content-card"
                      Padding="14"
                      Margin="0,8,0,0">
                <StackPanel Spacing="8">
                  <TextBlock Text="Create organization"
                             FontSize="18"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Create a new BKE Organization under this authenticated identity. Creation does not switch the current account automatically."
                             TextWrapping="Wrap"
                             Opacity="0.72" />

                  <TextBlock Text="Display name" FontWeight="SemiBold" />
                  <TextBox Text="{Binding OrganizationCreateDisplayName, Mode=TwoWay}"
                           MaxLength="120"
                           Watermark="Organization name" />

                  <TextBlock Text="Legal name" FontWeight="SemiBold" />
                  <TextBox Text="{Binding OrganizationCreateLegalName, Mode=TwoWay}"
                           MaxLength="180"
                           Watermark="Registered legal name" />

                  <TextBlock Text="Billing email" FontWeight="SemiBold" />
                  <TextBox Text="{Binding OrganizationCreateBillingEmail, Mode=TwoWay}"
                           MaxLength="320"
                           Watermark="billing@example.com" />

                  <TextBlock Text="Registration number (optional)"
                             FontWeight="SemiBold" />
                  <TextBox Text="{Binding OrganizationCreateRegistrationNumber, Mode=TwoWay}"
                           MaxLength="80" />

                  <TextBlock Text="Tax ID (optional)"
                             FontWeight="SemiBold" />
                  <TextBox Text="{Binding OrganizationCreateTaxId, Mode=TwoWay}"
                           MaxLength="80" />

                  <Button Content="Create organization"
                          IsEnabled="{Binding CanCreateOrganization}"
                          Click="CreateAccountOrganization" />
                  <TextBlock Text="{Binding OrganizationCreateStatus}"
                             FontSize="11"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding OrganizationCreateMessage}"
                             TextWrapping="Wrap"
                             Opacity="0.72" />
                </StackPanel>
              </Border>

              <Border IsVisible="{Binding ShowOrganizationSection}"
                      Classes="content-card"
                      Padding="14"
                      Margin="0,8,0,0">
                <StackPanel Spacing="9">
                  <TextBlock Text="Organization"
                             FontSize="18"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding AccountOrganizationStatus}"
                             FontSize="11"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding AccountOrganizationMessage}"
                             TextWrapping="Wrap"
                             Opacity="0.72" />
                  <Button Content="Refresh organization"
                          IsEnabled="{Binding CanRefreshAccountOrganization}"
                          Click="RefreshAccountOrganization" />

                  <StackPanel IsVisible="{Binding OrganizationReady}"
                              Spacing="7">
                    <TextBlock Text="{Binding OrganizationDisplayName}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding OrganizationLegalName}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding OrganizationRole}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding OrganizationLifecycle}"
                               FontSize="11"
                               Opacity="0.72" />

                    <StackPanel IsVisible="{Binding HasOrganizationRegistrationNumber}"
                                Spacing="2">
                      <TextBlock Text="Registration"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding OrganizationRegistrationNumber}"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowOrganizationBilling}"
                                Spacing="4"
                                Margin="0,6,0,0">
                      <TextBlock Text="Billing"
                                 FontWeight="SemiBold" />
                      <StackPanel IsVisible="{Binding HasOrganizationBillingEmail}"
                                  Spacing="2">
                        <TextBlock Text="Billing email"
                                   FontSize="11"
                                   Opacity="0.68" />
                        <TextBlock Text="{Binding OrganizationBillingEmail}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel IsVisible="{Binding HasOrganizationTaxId}"
                                  Spacing="2">
                        <TextBlock Text="Tax ID"
                                   FontSize="11"
                                   Opacity="0.68" />
                        <TextBlock Text="{Binding OrganizationTaxId}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>

                    <Border IsVisible="{Binding ShowOrganizationProfileEditor}"
                            Classes="content-card"
                            Padding="12"
                            Margin="0,6,0,0">
                      <StackPanel Spacing="7">
                        <TextBlock Text="Edit organization"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Only fields authorized for the selected Organization role are editable."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Opacity="0.68" />

                        <StackPanel IsVisible="{Binding CanEditOrganizationIdentity}"
                                    Spacing="5">
                          <TextBlock Text="Organization profile"
                                     FontWeight="SemiBold" />
                          <TextBlock Text="Display name"
                                     FontSize="11"
                                     Opacity="0.68" />
                          <TextBox Text="{Binding OrganizationEditDisplayName, Mode=TwoWay}"
                                   MaxLength="120" />
                          <TextBlock Text="Legal name"
                                     FontSize="11"
                                     Opacity="0.68" />
                          <TextBox Text="{Binding OrganizationEditLegalName, Mode=TwoWay}"
                                   MaxLength="180" />
                          <TextBlock Text="Registration number"
                                     FontSize="11"
                                     Opacity="0.68" />
                          <TextBox Text="{Binding OrganizationEditRegistrationNumber, Mode=TwoWay}"
                                   MaxLength="80"
                                   Watermark="Optional" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding CanEditOrganizationBilling}"
                                    Spacing="5"
                                    Margin="0,4,0,0">
                          <TextBlock Text="Billing profile"
                                     FontWeight="SemiBold" />
                          <TextBlock Text="Billing email"
                                     FontSize="11"
                                     Opacity="0.68" />
                          <TextBox Text="{Binding OrganizationEditBillingEmail, Mode=TwoWay}"
                                   MaxLength="320" />
                          <TextBlock Text="Tax ID"
                                     FontSize="11"
                                     Opacity="0.68" />
                          <TextBox Text="{Binding OrganizationEditTaxId, Mode=TwoWay}"
                                   MaxLength="80"
                                   Watermark="Optional" />
                        </StackPanel>

                        <Button Content="Save organization changes"
                                IsEnabled="{Binding CanSaveOrganizationProfile}"
                                Click="UpdateAccountOrganizationProfile" />
                        <TextBlock Text="{Binding OrganizationProfileUpdateStatus}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OrganizationProfileUpdateMessage}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                      </StackPanel>
                    </Border>

                    <StackPanel IsVisible="{Binding ShowOrganizationUsage}"
                                Spacing="4"
                                Margin="0,6,0,0">
                      <TextBlock Text="Usage / rights"
                                 FontWeight="SemiBold" />
                      <StackPanel IsVisible="{Binding HasOrganizationLicenseCount}"
                                  Orientation="Horizontal"
                                  Spacing="6">
                        <TextBlock Text="Licenses:" />
                        <TextBlock Text="{Binding OrganizationLicenseCount}"
                                   FontWeight="SemiBold" />
                      </StackPanel>
                      <StackPanel IsVisible="{Binding HasOrganizationSubscriptionCount}"
                                  Orientation="Horizontal"
                                  Spacing="6">
                        <TextBlock Text="Subscriptions:" />
                        <TextBlock Text="{Binding OrganizationSubscriptionCount}"
                                   FontWeight="SemiBold" />
                      </StackPanel>
                      <StackPanel IsVisible="{Binding HasOrganizationOrderCount}"
                                  Orientation="Horizontal"
                                  Spacing="6">
                        <TextBlock Text="Orders:" />
                        <TextBlock Text="{Binding OrganizationOrderCount}"
                                   FontWeight="SemiBold" />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowOrganizationMembers}"
                                Spacing="7"
                                Margin="0,6,0,0">
                      <Border IsVisible="{Binding ShowOrganizationInviteSection}"
                              Classes="content-card"
                              Padding="12"
                              Margin="0,5,0,4">
                        <StackPanel Spacing="7">
                          <TextBlock Text="Invite member"
                                     FontWeight="SemiBold" />
                          <TextBlock Text="Invitation authority stays in BKE Digital Solutions. Launcher sends only the invited email and role through the Licensing Agent."
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     Opacity="0.68" />

                          <StackPanel IsVisible="{Binding CanManageOrganizationInvitations}"
                                      Spacing="5">
                            <TextBlock Text="Email"
                                       FontSize="11"
                                       Opacity="0.68" />
                            <TextBox Text="{Binding OrganizationInvitationEmail, Mode=TwoWay}"
                                     MaxLength="320"
                                     Watermark="member@example.com" />
                            <TextBlock Text="Role"
                                       FontSize="11"
                                       Opacity="0.68" />
                            <ComboBox ItemsSource="{Binding OrganizationInvitationRoles}"
                                      SelectedItem="{Binding OrganizationInvitationRole, Mode=TwoWay}" />
                            <Button Content="Issue invitation"
                                    IsEnabled="{Binding CanInviteOrganizationMember}"
                                    Click="CreateAccountOrganizationInvitation" />
                          </StackPanel>

                          <StackPanel IsVisible="{Binding HasOrganizationInvitationCode}"
                                      Spacing="5">
                            <TextBlock Text="One-time invitation code"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Save or send this code before dismissing it. BKE does not persist a local copy and does not copy it to the clipboard automatically."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />
                            <TextBox Text="{Binding OrganizationInvitationCode, Mode=OneWay}"
                                     IsReadOnly="True" />
                            <Button Content="I've saved or sent this invitation code"
                                    Click="CompleteOrganizationInvitationDelivery" />
                          </StackPanel>

                          <TextBlock Text="{Binding OrganizationInvitationStatus}"
                                     FontSize="11"
                                     FontWeight="SemiBold" />
                          <TextBlock Text="{Binding OrganizationInvitationMessage}"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     Opacity="0.72" />
                        </StackPanel>
                      </Border>

                      <TextBlock Text="Members"
                                 FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding OrganizationMembers}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="contracts:AccountOrganizationMember">
                            <Border Classes="content-card"
                                    Padding="9"
                                    Margin="0,0,0,5">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Email}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Role}"
                                           FontSize="11"
                                           Opacity="0.72" />
                                <WrapPanel Margin="0,4,0,0"
                                           ItemSpacing="6"
                                           LineSpacing="6">
                                  <Button Content="Member"
                                          Click="SetOrganizationMemberRoleMember" />
                                  <Button Content="License manager"
                                          Click="SetOrganizationMemberRoleLicenseManager" />
                                  <Button Content="Billing"
                                          Click="SetOrganizationMemberRoleBilling" />
                                  <Button Content="Owner"
                                          Click="SetOrganizationMemberRoleOwner" />
                                  <Button Content="Remove"
                                          Click="RemoveOrganizationMember" />
                                </WrapPanel>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="No organization members were returned."
                                 IsVisible="{Binding ShowEmptyOrganizationMembers}"
                                 Opacity="0.68"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding OrganizationMemberManagementStatus}"
                                 FontSize="11"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding OrganizationMemberManagementMessage}"
                                 FontSize="11"
                                 Opacity="0.72"
                                 TextWrapping="Wrap" />

                      <TextBlock Text="Pending invitations"
                                 FontWeight="SemiBold"
                                 Margin="0,5,0,0" />
                      <ItemsControl ItemsSource="{Binding OrganizationInvitations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="contracts:AccountOrganizationInvitation">
                            <Border Classes="content-card"
                                    Padding="9"
                                    Margin="0,0,0,5">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Email}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Role}" />
                                <TextBlock Text="{Binding Status}"
                                           FontSize="11"
                                           Opacity="0.72" />
                                <TextBlock Text="{Binding ExpiresAt}"
                                           FontSize="11"
                                           Opacity="0.72"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="0,4,0,0">
                                  <Button Content="Resend"
                                          Click="ResendOrganizationInvitation" />
                                  <Button Content="Revoke"
                                          Click="RevokeOrganizationInvitation" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="No pending invitations were returned."
                                 IsVisible="{Binding ShowEmptyOrganizationInvitations}"
                                 Opacity="0.68"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Height="1" Margin="0,8,0,4" Opacity="0.25" />

              <TextBlock Text="Security" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Change your BKE password. A successful change signs this machine out so you can authenticate again with the new password."
                         TextWrapping="Wrap"
                         Opacity="0.72" />
              <TextBlock Text="Current password" FontWeight="SemiBold" />
              <TextBox Text="{Binding CurrentPassword, Mode=TwoWay}"
                       PasswordChar="●" />
              <TextBlock Text="New password" FontWeight="SemiBold" />
              <TextBox Text="{Binding NewPassword, Mode=TwoWay}"
                       PasswordChar="●" />
              <TextBlock Text="Confirm new password" FontWeight="SemiBold" />
              <TextBox Text="{Binding ConfirmNewPassword, Mode=TwoWay}"
                       PasswordChar="●" />
              <Button Content="Change password"
                      IsEnabled="{Binding CanChangePassword}"
                      Click="ChangePassword" />
              <TextBlock Text="{Binding PasswordChangeStatus}"
                         FontSize="11"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding PasswordChangeMessage}"
                         TextWrapping="Wrap"
                         Opacity="0.72" />

              <Border Height="1" Margin="0,8,0,4" Opacity="0.25" />

              <TextBlock Text="Multi-factor authentication"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding AccountMfaSummary}"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding AccountMfaMessage}"
                         TextWrapping="Wrap"
                         Opacity="0.72" />
              <Button Content="Refresh MFA status"
                      Click="RefreshAccountMfa" />
              <TextBlock Text="Current password"
                         FontWeight="SemiBold" />
              <TextBox Text="{Binding AccountMfaCurrentPassword, Mode=TwoWay}"
                       PasswordChar="●" />

              <StackPanel IsVisible="{Binding ShowMfaEnableActions}" Spacing="8">
                <Button Content="Enable MFA"
                        IsEnabled="{Binding CanStartMfaEnrollment}"
                        Click="StartMfaEnrollment" />
              </StackPanel>

              <StackPanel IsVisible="{Binding ShowMfaProtectedActions}" Spacing="8">
                <Button Content="Verify password for MFA changes"
                        IsEnabled="{Binding CanStartMfaProof}"
                        Click="StartMfaProof" />
              </StackPanel>

              <StackPanel IsVisible="{Binding HasAccountMfaChallenge}" Spacing="8">
                <TextBlock Text="{Binding AccountMfaReference}"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding AccountMfaCode, Mode=TwoWay}"
                         Watermark="Verification code" />
                <Button Content="Complete MFA enrollment"
                        IsVisible="{Binding ShowMfaEnrollmentChallenge}"
                        IsEnabled="{Binding CanCompleteMfaEnrollment}"
                        Click="CompleteMfaEnrollment" />
                <StackPanel IsVisible="{Binding ShowMfaProofChallenge}" Spacing="8">
                  <Button Content="Disable MFA"
                          IsEnabled="{Binding CanSubmitMfaProof}"
                          Click="DisableMfa" />
                  <Button Content="Regenerate recovery codes"
                          IsEnabled="{Binding CanSubmitMfaProof}"
                          Click="RegenerateMfaRecovery" />
                </StackPanel>
              </StackPanel>

              <Border Height="1" Margin="0,8,0,4" Opacity="0.25" />

              <TextBlock Text="Privacy requests"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="Request types and status come from BKE Digital Solutions through the Licensing Agent. BKE does not store a separate local privacy-request record."
                         TextWrapping="Wrap"
                         Opacity="0.72" />
              <TextBlock Text="{Binding AccountPrivacyStatus}"
                         FontSize="11"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding AccountPrivacyMessage}"
                         TextWrapping="Wrap"
                         Opacity="0.72" />
              <Button Content="Refresh privacy requests"
                      IsEnabled="{Binding CanRefreshAccountPrivacy}"
                      Click="RefreshAccountPrivacy" />

              <TextBlock Text="Request type"
                         FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding AccountPrivacyRequestTypes}"
                        SelectedItem="{Binding SelectedAccountPrivacyRequestType, Mode=TwoWay}" />

              <TextBlock Text="Summary"
                         FontWeight="SemiBold" />
              <TextBox Text="{Binding AccountPrivacySummary, Mode=TwoWay}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="90"
                       MaxHeight="180"
                       Watermark="Describe what you are requesting (10–2,000 characters)" />
              <Button Content="Submit privacy request"
                      IsEnabled="{Binding CanCreateAccountPrivacyRequest}"
                      Click="CreateAccountPrivacyRequest" />

              <ItemsControl ItemsSource="{Binding AccountPrivacyRequests}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AccountPrivacyRequestViewModel">
                    <Border Classes="content-card"
                            Padding="12"
                            Margin="0,0,0,8">
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding RequestType}"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding Status}"
                                     FontSize="11"
                                     FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="{Binding ScopeLabel}"
                                   FontSize="11"
                                   Opacity="0.68" />
                        <TextBlock Text="{Binding Summary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResponseSummary}"
                                   IsVisible="{Binding HasResponseSummary}"
                                   TextWrapping="Wrap"
                                   Opacity="0.78" />
                        <TextBlock Text="{Binding CreatedLabel}"
                                   FontSize="11"
                                   Opacity="0.68" />
                        <TextBlock Text="{Binding LifecycleLabel}"
                                   FontSize="11"
                                   Opacity="0.68"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border IsVisible="{Binding ShowEmptyAccountPrivacyRequests}"
                      Classes="content-card"
                      Padding="12">
                <TextBlock Text="No privacy requests are recorded yet."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Opacity="0.68" />
              </Border>

              <Border Height="1" Margin="0,8,0,4" Opacity="0.25" />

              <TextBlock Text="Redeem Claim Code" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Codes redeem into the signed-in account shown above."
                         TextWrapping="Wrap"
                         Opacity="0.72" />
              <TextBox Text="{Binding ClaimCode, Mode=TwoWay}"
                       Watermark="BKE-CLM-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" />
              <Button Content="Redeem Claim Code"
                      IsEnabled="{Binding CanRedeemClaimCode}"
                      Click="RedeemClaimCode" />
              <TextBlock Text="{Binding ClaimMessage}"
                         TextWrapping="Wrap"
                         Opacity="0.72" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Classes="surface" Padding="18">
          <TabControl SelectedIndex="{Binding SelectedModuleIndex, Mode=TwoWay}"
                      SelectionChanged="ModuleChanged">
          <TabItem Header="My Software">
            <Grid RowDefinitions="Auto,Auto,*" Margin="4,14,4,4">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Text="My Software" Classes="section-title" />
                  <TextBlock Text="{Binding CatalogMessage}" TextWrapping="Wrap" Opacity="0.72" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <Border Classes="content-card" Padding="10,6" CornerRadius="8">
                    <TextBlock Text="{Binding CatalogStatus}" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <Button Content="Refresh software" Click="RefreshCatalog" />
                </StackPanel>
              </Grid>

              <TextBlock Grid.Row="1"
                         Text="Execution policy comes from Digital Solutions; installed state comes from the Licensing Agent."
                         TextWrapping="Wrap"
                         Opacity="0.62"
                         Margin="0,12,0,14" />

              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SoftwareProductViewModel">
                        <Border Classes="content-card" Padding="14" CornerRadius="10" Margin="0,0,0,8">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Grid.Column="1" Text="{Binding StateLabel}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.72" Margin="0,4,18,0" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                              <TextBlock Text="{Binding ExecutionLabel}" FontSize="11" Opacity="0.72" />
                              <TextBlock Text="{Binding VersionLabel}" FontSize="11" Opacity="0.72" />
                            </StackPanel>
                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="16,6,0,0">
                              <Button Content="Install"
                                      IsVisible="{Binding CanInstall}"
                                      Click="InstallProduct" />
                              <Button Content="Update"
                                      IsVisible="{Binding CanUpdate}"
                                      Click="UpdateProduct" />
                              <Button Content="Repair"
                                      IsVisible="{Binding CanRepair}"
                                      Click="RepairProduct" />
                              <Button Content="Open"
                                      IsVisible="{Binding CanOpen}"
                                      Click="OpenProduct" />
                              <Button Content="Remove"
                                      IsVisible="{Binding CanRemove}"
                                      Click="RemoveProduct" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border IsVisible="{Binding ShowEmptyProducts}" Classes="content-card" Padding="18" CornerRadius="10">
                    <TextBlock Text="No Agent-projected software is available yet."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Opacity="0.68" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </TabItem>

          <TabItem Header="Notifications">
            <Grid RowDefinitions="Auto,Auto,*" Margin="4,14,4,4">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Text="Notifications" Classes="section-title" />
                  <TextBlock Text="{Binding NotificationMessage}"
                             TextWrapping="Wrap"
                             Opacity="0.72" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10">
                  <Border Classes="content-card" Padding="10,6" CornerRadius="8">
                    <TextBlock Text="{Binding NotificationStatus}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                  </Border>
                  <Button Content="Refresh notifications"
                          Click="RefreshNotifications"
                          IsEnabled="{Binding CanRefreshNotifications}" />
                </StackPanel>
              </Grid>

              <TextBlock Grid.Row="1"
                         Text="This inbox is scoped by Digital Solutions to the selected BKE account and is mediated by the Licensing Agent. Mark Read and Dismiss are server-authoritative receipt actions."
                         TextWrapping="Wrap"
                         Opacity="0.62"
                         Margin="0,12,0,14" />

              <ScrollViewer Grid.Row="2"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <ItemsControl ItemsSource="{Binding Notifications}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NotificationViewModel">
                        <Border Classes="content-card"
                                Padding="14"
                                CornerRadius="10"
                                Margin="0,0,0,8">
                          <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Title}"
                                         FontWeight="SemiBold"
                                         FontSize="15"
                                         TextWrapping="Wrap" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding StateLabel}"
                                         FontSize="11"
                                         FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock Text="{Binding Body}"
                                       TextWrapping="Wrap"
                                       Opacity="0.82" />
                            <WrapPanel>
                              <TextBlock Text="{Binding CategoryLabel}"
                                         FontSize="11"
                                         Opacity="0.68"
                                         Margin="0,0,12,0" />
                              <TextBlock Text="{Binding SeverityLabel}"
                                         FontSize="11"
                                         Opacity="0.68"
                                         Margin="0,0,12,0" />
                              <TextBlock Text="{Binding ProductLabel}"
                                         FontSize="11"
                                         Opacity="0.68"
                                         Margin="0,0,12,0" />
                              <TextBlock Text="{Binding SourceLabel}"
                                         FontSize="11"
                                         Opacity="0.68"
                                         Margin="0,0,12,0" />
                              <TextBlock Text="{Binding CreatedLabel}"
                                         FontSize="11"
                                         Opacity="0.68" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,4,0,0">
                              <Button Content="Mark read"
                                      Click="MarkNotificationRead"
                                      IsVisible="{Binding CanMarkRead}" />
                              <Button Content="Dismiss"
                                      Click="DismissNotification" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border IsVisible="{Binding ShowEmptyNotifications}"
                          Classes="content-card"
                          Padding="18"
                          CornerRadius="10">
                    <TextBlock Text="No notifications are available for this BKE account."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Opacity="0.68" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </TabItem>

          <TabItem Header="Store">
            <Grid RowDefinitions="Auto,Auto,*" Margin="4,14,4,4">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Text="Store" Classes="section-title" />
                  <TextBlock Text="{Binding StoreMessage}" TextWrapping="Wrap" Opacity="0.72" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <Border Classes="content-card" Padding="10,6" CornerRadius="8">
                    <TextBlock Text="{Binding StoreStatus}" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <Button Content="Refresh Store" Click="RefreshStore" />
                </StackPanel>
              </Grid>

              <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,14">
                <TextBlock Text="{Binding GiftCheckoutLabel}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock Text="Plans and prices are catalog presentation only in this pre-production build. Secure checkout authority remains with BKE Digital Solutions."
                           TextWrapping="Wrap"
                           Opacity="0.62" />
                <Border IsVisible="{Binding ShowPurchaseReview}"
                        Classes="content-card"
                        Padding="12"
                        CornerRadius="8"
                        Margin="0,8,0,0">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Purchase review" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding PurchaseReviewStatus}"
                                 FontSize="11"
                                 FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="{Binding PurchaseReviewMessage}"
                               TextWrapping="Wrap"
                               Opacity="0.78" />
                    <TextBlock Text="{Binding PurchaseReviewProductLabel}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PurchaseReviewEditionLabel}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PurchaseReviewPriceLabel}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PurchaseReviewModesLabel}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PurchaseReviewLegalLabel}"
                               TextWrapping="Wrap"
                               Opacity="0.78" />
                    <TextBlock Text="Review only — no order, payment, or checkout has been created yet."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Opacity="0.62" />

                    <StackPanel IsVisible="{Binding ShowPurchaseActions}"
                                Spacing="8"
                                Margin="0,8,0,0">
                      <TextBlock Text="Required Legal documents"
                                 FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding PurchaseLegalDocuments}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PurchaseLegalDocumentViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,2">
                              <CheckBox Content="{Binding Label}"
                                        IsChecked="{Binding IsAccepted, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                              <Button Grid.Column="1"
                                      Content="Open"
                                      Click="OpenPurchaseLegalDocument" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="SELF binds the paid software right to this signed-in account. GIFT creates an unbound one-time Claim Code after confirmed payment."
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Opacity="0.72" />

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Buy for myself"
                                Click="BuyForSelf"
                                IsEnabled="{Binding CanBuySelf}" />
                        <Button Content="Buy as gift / Claim Code"
                                Click="BuyAsGift"
                                IsEnabled="{Binding CanBuyGift}" />
                      </StackPanel>

                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowPurchaseCheckoutState}"
                                Spacing="8"
                                Margin="0,8,0,0">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding PurchaseCheckoutMessage}"
                                   TextWrapping="Wrap"
                                   Opacity="0.78" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PurchaseCheckoutStatus}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                      </Grid>

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Check checkout status"
                                Click="CheckPurchaseCheckoutStatus"
                                IsEnabled="{Binding CanCheckCheckoutStatus}" />
                        <Button Content="Resume original checkout"
                                Click="RetryOriginalCheckout"
                                IsEnabled="{Binding CanRetryOriginalCheckout}" />
                        <Button Content="Open existing checkout"
                                Click="OpenExistingCheckout"
                                IsEnabled="{Binding CanOpenExistingCheckout}" />
                      </StackPanel>

                      <Border IsVisible="{Binding HasGiftClaimCode}"
                                Classes="content-card"
                              Padding="12"
                              CornerRadius="8">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Gift Claim Code"
                                     FontWeight="SemiBold" />
                          <TextBox Text="{Binding GiftClaimCode, Mode=OneWay}"
                                   IsReadOnly="True"
                                   TextWrapping="Wrap" />
                          <TextBlock Text="This is an unbound one-time Claim Code. Send it to the intended recipient; the first eligible BKE account that successfully redeems it becomes the software owner. BKE Launcher keeps this plaintext in memory only."
                                     TextWrapping="Wrap"
                                     FontSize="11"
                                     Opacity="0.72" />
                          <Button Content="I've saved this Claim Code"
                                  Click="CompleteGiftClaimDelivery"
                                  IsEnabled="{Binding CanCompleteGiftDelivery}" />
                        </StackPanel>
                      </Border>

                      <TextBlock Text="Checkout-status recovery is read-only. It checks the existing correlation and never creates a second order or payment."
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Opacity="0.62" />
                      <TextBlock Text="Secure payment opens from a Digital Solutions-created checkout target. BKE never chooses the price, payment provider, destination account, or gift recipient."
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Opacity="0.62" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <ItemsControl ItemsSource="{Binding StoreProducts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StoreProductViewModel">
                        <Border Classes="content-card" Padding="14" CornerRadius="10" Margin="0,0,0,8">
                          <StackPanel Spacing="8">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.78" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.62" />

                            <ItemsControl ItemsSource="{Binding Editions}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StoreEditionViewModel">
                                  <Border Classes="content-card" Padding="12" CornerRadius="8" Margin="0,4,0,4">
                                    <StackPanel Spacing="5">
                                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.72" />
                                      <TextBlock Text="{Binding UsageLabel}" TextWrapping="Wrap" FontSize="11" Opacity="0.68" />
                                      <TextBlock Text="{Binding FeatureSummary}" TextWrapping="Wrap" FontSize="11" Opacity="0.68" />

                                      <ItemsControl ItemsSource="{Binding Plans}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="vm:StorePlanViewModel">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                              <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DetailLabel}" FontSize="11" Opacity="0.68" />
                                              </StackPanel>
                                              <StackPanel Grid.Column="1"
                                                          Spacing="6"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PriceLabel}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" />
                                                <Button Content="Review purchase"
                                                        Click="ReviewPurchase" />
                                              </StackPanel>
                                            </Grid>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border IsVisible="{Binding ShowEmptyStore}" Classes="content-card" Padding="18" CornerRadius="10">
                    <TextBlock Text="No purchasable products are currently available."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Opacity="0.68" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </TabItem>
          </TabControl>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
