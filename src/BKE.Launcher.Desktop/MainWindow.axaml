<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BKE.Launcher.Presentation"
        xmlns:contracts="using:BKE.Launcher.Contracts"
        x:Class="BKE.Launcher.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BKE"
        Width="1024"
        Height="680"
        MinWidth="760"
        MinHeight="540"
        CanResize="True"
        CanMinimize="True"
        CanMaximize="True"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None">
  <Grid>
    <Border IsVisible="{Binding ShowLoginPage}"
            Classes="surface"
            Width="560"
            Padding="34"
            CornerRadius="18"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <ScrollViewer MaxHeight="650"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <TextBlock Text="BKE"
                     Classes="brand"
                     FontSize="38"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Your software. One account. One place."
                     Classes="muted"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Message}"
                     Classes="muted"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />

          <!-- GOOGLE SIGN-IN ENTRY (Only login path) -->
          <StackPanel IsVisible="{Binding ShowSignInForm}" Spacing="14">
            <Button Content="Continue with Google"
                    Classes="primary"
                    HorizontalAlignment="Stretch"
                    Click="ContinueWithGoogle" />
            <TextBlock Text="Sign in with your Google account in your default browser to connect this device."
                       Classes="muted"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
          </StackPanel>

          <!-- PENDING DEVICE APPROVAL (Google device approval in browser) -->
          <StackPanel IsVisible="{Binding ShowPendingSignIn}" Spacing="14">
            <TextBlock Text="Approve BKE Device"
                       FontWeight="Bold"
                       FontSize="20"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Complete sign-in in your system browser to connect this device to your BKE account."
                       Classes="muted"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />

            <Border Background="{DynamicResource BkeInsetBrush}"
                    BorderBrush="{DynamicResource BkeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    HorizontalAlignment="Stretch">
              <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="CONFIRMATION CODE"
                           Classes="muted"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding UserCode}"
                           FontWeight="Bold"
                           FontSize="24"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Border>

            <Button Content="Open browser again"
                    HorizontalAlignment="Stretch"
                    Click="OpenVerificationPage" />

            <Button Content="Check approval status"
                    Classes="primary"
                    HorizontalAlignment="Stretch"
                    Click="RefreshSessionStatus" />

            <Button Content="Cancel"
                    HorizontalAlignment="Stretch"
                    Click="CancelGoogleSignIn" />
          </StackPanel>

          <!-- AGENT UNAVAILABLE / CONNECTION RECOVERY (Dedicated recoverable state) -->
          <StackPanel IsVisible="{Binding ShowAgentUnavailableRecovery}" Spacing="14">
            <Border Background="#1C1315"
                    BorderBrush="#FF5252"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    HorizontalAlignment="Stretch">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="Licensing Agent Unavailable"
                           FontWeight="Bold"
                           FontSize="18"
                           Foreground="#FF6B6B"
                           HorizontalAlignment="Center" />
                <TextBlock Text="BKE cannot connect to the local Licensing Agent at 127.0.0.1:43873. The background service is required for device authorization and software licensing."
                           Classes="muted"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <TextBlock Text="{Binding Message}"
                           Classes="muted"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
              </StackPanel>
            </Border>

            <Button Content="Retry connection"
                    Classes="primary"
                    HorizontalAlignment="Stretch"
                    Click="RefreshSessionStatus" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid IsVisible="{Binding ShowAuthenticatedShell}"
          ColumnDefinitions="Auto,*"
          Margin="16,36,16,16">
      <Border Width="{Binding SidebarWidth}"
              Classes="sidebar"
              Padding="10">
        <Grid RowDefinitions="Auto,*,Auto"
              RowSpacing="14">
          <Grid IsVisible="{Binding IsSidebarExpanded}"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="8">
            <Button Width="40"
                    Height="40"
                    Classes="icon-button"
                    Click="ToggleSidebar"
                    ToolTip.Tip="Collapse navigation">
              <LucideIcon Kind="Menu"
                          Size="18"
                          StrokeWidth="1.8"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Button>
            <TextBlock Grid.Column="1"
                       Text="BKE"
                       Classes="brand"
                       FontSize="21"
                       VerticalAlignment="Center" />
          </Grid>

          <Button IsVisible="{Binding IsSidebarCollapsed}"
                  Width="40"
                  Height="40"
                  Classes="icon-button"
                  HorizontalAlignment="Center"
                  Click="ToggleSidebar"
                  ToolTip.Tip="Expand navigation">
            <LucideIcon Kind="Menu"
                        Size="18"
                        StrokeWidth="1.8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
          </Button>

          <StackPanel Grid.Row="1"
                      Spacing="4">
            <Button Classes="sidebar-nav"
                    Classes.compact="{Binding IsSidebarCollapsed}"
                    Classes.active="{Binding ShowHomeModule}"
                    Click="OpenDashboard"
                    ToolTip.Tip="Dashboard">
              <Grid>
                <Grid IsVisible="{Binding IsSidebarExpanded}"
                      ColumnDefinitions="28,*"
                      ColumnSpacing="8">
                  <Border Classes="sidebar-glyph">
                    <LucideIcon Kind="LayoutDashboard"
                                Size="14"
                                StrokeWidth="1.8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1"
                             Text="Dashboard"
                             FontSize="13"
                             VerticalAlignment="Center"
                             FontWeight="SemiBold" />
                </Grid>
                <Border IsVisible="{Binding IsSidebarCollapsed}"
                        Classes="sidebar-glyph"
                        HorizontalAlignment="Center">
                  <LucideIcon Kind="LayoutDashboard"
                              Size="14"
                              StrokeWidth="1.8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>

            <Button Classes="sidebar-nav"
                    Classes.compact="{Binding IsSidebarCollapsed}"
                    Classes.active="{Binding ShowLibraryModule}"
                    Click="OpenLibrary"
                    ToolTip.Tip="Library">
              <Grid>
                <Grid IsVisible="{Binding IsSidebarExpanded}"
                      ColumnDefinitions="28,*"
                      ColumnSpacing="8">
                  <Border Classes="sidebar-glyph">
                    <LucideIcon Kind="Library"
                                Size="14"
                                StrokeWidth="1.8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1"
                             Text="Library"
                             FontSize="13"
                             VerticalAlignment="Center"
                             FontWeight="SemiBold" />
                </Grid>
                <Border IsVisible="{Binding IsSidebarCollapsed}"
                        Classes="sidebar-glyph"
                        HorizontalAlignment="Center">
                  <LucideIcon Kind="Library"
                              Size="14"
                              StrokeWidth="1.8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>

            <Button Classes="sidebar-nav"
                    Classes.compact="{Binding IsSidebarCollapsed}"
                    Classes.active="{Binding ShowStoreModule}"
                    Click="OpenStore"
                    ToolTip.Tip="Store">
              <Grid>
                <Grid IsVisible="{Binding IsSidebarExpanded}"
                      ColumnDefinitions="28,*"
                      ColumnSpacing="8">
                  <Border Classes="sidebar-glyph">
                    <LucideIcon Kind="Store"
                                Size="14"
                                StrokeWidth="1.8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1"
                             Text="Store"
                             FontSize="13"
                             VerticalAlignment="Center"
                             FontWeight="SemiBold" />
                </Grid>
                <Border IsVisible="{Binding IsSidebarCollapsed}"
                        Classes="sidebar-glyph"
                        HorizontalAlignment="Center">
                  <LucideIcon Kind="Store"
                              Size="14"
                              StrokeWidth="1.8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
          </StackPanel>

          <StackPanel Grid.Row="2"
                      Spacing="6">
            <Border Height="1"
                    Background="#252B33"
                    Margin="4,0,4,4" />

            <Button Classes="sidebar-nav"
                    Classes.compact="{Binding IsSidebarCollapsed}"
                    Classes.active="{Binding ShowNotificationsModule}"
                    Click="OpenNotifications"
                    ToolTip.Tip="Notifications">
              <Grid>
                <Grid IsVisible="{Binding IsSidebarExpanded}"
                      ColumnDefinitions="28,*"
                      ColumnSpacing="8">
                  <Border Classes="sidebar-glyph">
                    <LucideIcon Kind="Bell"
                                Size="14"
                                StrokeWidth="1.8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                  </Border>
                  <Grid Grid.Column="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock Text="Notifications"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            IsVisible="{Binding HasPendingUpdatesOrActivity}"
                            Background="{StaticResource BkeDigitalYellowBrush}"
                            CornerRadius="999"
                            Padding="6,1"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding PendingUpdatesBadgeText}"
                                 Foreground="#0A0C0F"
                                 FontSize="10"
                                 FontWeight="Bold" />
                    </Border>
                  </Grid>
                </Grid>
                <Grid IsVisible="{Binding IsSidebarCollapsed}">
                  <Border Classes="sidebar-glyph"
                          HorizontalAlignment="Center">
                    <LucideIcon Kind="Bell"
                                Size="14"
                                StrokeWidth="1.8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                  </Border>
                  <Border IsVisible="{Binding HasPendingUpdatesOrActivity}"
                          Width="7"
                          Height="7"
                          CornerRadius="999"
                          Background="{StaticResource BkeDigitalYellowBrush}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,2,6,0" />
                </Grid>
              </Grid>
            </Button>

            <Button Classes="sidebar-nav"
                    Classes.compact="{Binding IsSidebarCollapsed}"
                    Click="OpenAccount"
                    ToolTip.Tip="Account">
              <Grid>
                <Grid IsVisible="{Binding IsSidebarExpanded}"
                      ColumnDefinitions="38,*"
                      ColumnSpacing="10">
                  <Border Classes="avatar">
                    <TextBlock Text="{Binding AccountInitials}"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1"
                              VerticalAlignment="Center"
                              Spacing="1">
                    <TextBlock Text="{Binding AccountDisplay}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="125" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="5">
                      <Border Width="6"
                              Height="6"
                              Classes="signal-dot"
                              VerticalAlignment="Center" />
                      <TextBlock Text="Connected"
                                 Classes="muted"
                                 FontSize="9" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <Border IsVisible="{Binding IsSidebarCollapsed}"
                        Classes="avatar"
                        HorizontalAlignment="Center">
                  <TextBlock Text="{Binding AccountInitials}"
                             FontSize="11"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1"
            Margin="18,0,0,0"
            ClipToBounds="True"
            Background="#080A10">

        <Border IsHitTestVisible="False"
                Opacity="0.28">
          <Border.Background>
            <VisualBrush TileMode="Tile"
                         DestinationRect="0,0,64,64"
                         Stretch="None">
              <VisualBrush.Visual>
                <Grid Width="64"
                      Height="64">
                  <Border BorderBrush="#24FFFFFF"
                          BorderThickness="1,1,0,0" />
                </Grid>
              </VisualBrush.Visual>
            </VisualBrush>
          </Border.Background>
        </Border>

        <Ellipse IsHitTestVisible="False"
                 Width="980"
                 Height="660"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-210,-260,0">
          <Ellipse.Fill>
            <RadialGradientBrush Center="50%,50%"
                                 GradientOrigin="50%,50%">
              <GradientStop Color="#70172947" Offset="0" />
              <GradientStop Color="#24172947" Offset="0.42" />
              <GradientStop Color="#00172947" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>

        <Ellipse IsHitTestVisible="False"
                 Width="820"
                 Height="560"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-250,0,0,-210">
          <Ellipse.Fill>
            <RadialGradientBrush Center="50%,50%"
                                 GradientOrigin="50%,50%">
              <GradientStop Color="#552A2516" Offset="0" />
              <GradientStop Color="#1A2A2516" Offset="0.48" />
              <GradientStop Color="#002A2516" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>

        <Ellipse IsHitTestVisible="False"
                 Width="720"
                 Height="360"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,140,-190">
          <Ellipse.Fill>
            <RadialGradientBrush Center="50%,50%"
                                 GradientOrigin="50%,50%">
              <GradientStop Color="#24FFD15A" Offset="0" />
              <GradientStop Color="#08FFD15A" Offset="0.52" />
              <GradientStop Color="#00FFD15A" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>

        <Border IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%"
                                 EndPoint="100%,100%">
              <GradientStop Color="#00172947" Offset="0" />
              <GradientStop Color="#10080A10" Offset="0.5" />
              <GradientStop Color="#28080A10" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <Border MaxWidth="480"
                HorizontalAlignment="Left"
                Classes="signal-panel"
                Padding="22"
                IsVisible="{Binding ShowAccountSurface}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
              <TextBlock Text="Account" Classes="section-title" />

              <Border Classes="content-card" Padding="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding AccountDisplay}"
                             FontWeight="SemiBold"
                             FontSize="16"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding AccountTypeLabel}"
                             FontSize="12"
                             Opacity="0.72" />
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <Border Width="8" Height="8" Classes="signal-dot" VerticalAlignment="Center" />
                    <TextBlock Text="Session active via Licensing Agent"
                               Classes="muted"
                               FontSize="11"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" />

              <Button Content="Manage account in Digital Solutions"
                      Classes="primary"
                      HorizontalAlignment="Stretch"
                      Click="OpenAccountManagement" />

              <TextBlock Text="Account profile, organizations, commercial seats, billing, and gift claims are managed directly on the Digital Solutions platform."
                         Classes="muted"
                         FontSize="11"
                         TextWrapping="Wrap" />

              <Border Height="1" Background="{DynamicResource BkeBorderBrush}" Margin="0,4" />

              <Button Content="Refresh account status"
                      HorizontalAlignment="Stretch"
                      Click="RefreshStatus" />

              <Button Content="Switch BKE account"
                      HorizontalAlignment="Stretch"
                      IsEnabled="{Binding CanSwitchAccount}"
                      Click="SwitchAccount" />
              <TextBlock Text="{Binding SwitchAccountHint}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Opacity="0.68" />

              <Button Content="Sign out on this machine"
                      HorizontalAlignment="Stretch"
                      Click="Logout" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Grid>
          <Grid>
          <Grid IsVisible="{Binding ShowHomeModule}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="26"
                          Margin="2,4,12,14">

                <Grid MinHeight="332">
                  <Border Classes="obsidian-depth"
                          Margin="13,17,0,0" />
                  <Border Background="#E00A0C0F"
                          BorderBrush="#1E242B"
                          BorderThickness="1"
                          CornerRadius="29"
                          Margin="7,9,6,5" />
                  <Border Classes="obsidian-hero"
                          Margin="0,0,13,13"
                          Padding="24">
                    <Grid ColumnDefinitions="*,208,164"
                          ColumnSpacing="16">

                      <StackPanel Spacing="10"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding AccountGreeting}"
                                   Classes="display-title"
                                   FontSize="30"
                                   TextWrapping="Wrap"
                                   MaxWidth="310" />
                        <TextBlock Text="{Binding Telemetry.HealthDetail}"
                                   Classes="muted"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   MaxWidth="310" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="0,14,0,0">
                          <Border Classes="status-pill"
                                  Padding="11,7">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="7">
                              <Border Width="6"
                                      Height="6"
                                      Classes="signal-dot"
                                      VerticalAlignment="Center" />
                              <TextBlock Text="Live"
                                         FontSize="10"
                                         FontWeight="SemiBold" />
                            </StackPanel>
                          </Border>
                          <Border Classes="status-pill"
                                  Padding="11,7">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="7">
                              <TextBlock Text="Uptime"
                                         Classes="muted"
                                         FontSize="10" />
                              <TextBlock Text="{Binding Telemetry.UptimeLabel}"
                                         FontSize="10"
                                         FontWeight="SemiBold" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </StackPanel>

                      <Grid Grid.Column="1"
                            Width="208"
                            Height="208"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Ellipse Width="168"
                                 Height="48"
                                 Fill="#5C000000"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,12" />
                        <Ellipse Width="196"
                                 Height="196"
                                 Stroke="#182129"
                                 StrokeThickness="1" />
                        <Ellipse Width="170"
                                 Height="170"
                                 Stroke="#273540"
                                 StrokeThickness="1" />
                        <Ellipse Width="142"
                                 Height="142"
                                 Stroke="#233A49"
                                 StrokeThickness="1" />
                        <Ellipse Width="112"
                                 Height="112"
                                 Fill="#100F1318"
                                 Stroke="#3A8177FF"
                                 StrokeThickness="1" />

                        <Grid Width="196"
                              Height="196"
                              Classes="ds-orbit-clockwise"
                              RenderTransformOrigin="50%,50%">
                          <Grid.RenderTransform>
                            <RotateTransform Angle="0" />
                          </Grid.RenderTransform>
                          <Ellipse Width="196"
                                   Height="196"
                                   Stroke="#66FFD15A"
                                   StrokeThickness="1.15"
                                   StrokeDashArray="15,8,3,10" />
                          <Grid Width="13"
                                Height="13"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,-4,0,0">
                            <Ellipse Width="13"
                                     Height="13"
                                     Fill="#24FFD15A" />
                            <Border Width="7"
                                    Height="7"
                                    Background="{StaticResource BkeDigitalYellowBrush}"
                                    BorderBrush="#FFFFE7A3"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                          </Grid>
                        </Grid>

                        <Grid Width="142"
                              Height="142"
                              Classes="ds-orbit-counter"
                              RenderTransformOrigin="50%,50%">
                          <Grid.RenderTransform>
                            <RotateTransform Angle="0" />
                          </Grid.RenderTransform>
                          <Ellipse Width="142"
                                   Height="142"
                                   Stroke="#5867D9FF"
                                   StrokeThickness="1.05"
                                   StrokeDashArray="10,6,2,8" />
                          <Grid Width="12"
                                Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,-3,0,0">
                            <Ellipse Width="12"
                                     Height="12"
                                     Fill="#2467D9FF" />
                            <Border Width="6"
                                    Height="6"
                                    Background="{StaticResource BkeSignalBrush}"
                                    BorderBrush="#D8F7FF"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                          </Grid>
                        </Grid>

                        <Border Width="86"
                                Height="86"
                                Classes="core-disc"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                          <Grid>
                            <Ellipse Width="74"
                                     Height="74"
                                     Stroke="#2467D9FF"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="1">
                              <TextBlock Text="BKE"
                                         FontSize="21"
                                         FontWeight="SemiBold"
                                         LetterSpacing="1"
                                         TextAlignment="Center" />
                              <TextBlock Text="CORE"
                                         Classes="kicker"
                                         FontSize="7"
                                         TextAlignment="Center" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Grid>

                      <StackPanel Grid.Column="2"
                                  Spacing="10"
                                  VerticalAlignment="Center">
                        <Border Classes="obsidian-metric"
                                Padding="15">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                              <TextBlock Text="CPU"
                                         Classes="kicker"
                                         FontSize="8" />
                              <TextBlock Text="Processor"
                                         Classes="muted"
                                         FontSize="10" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Telemetry.CpuLabel}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Border Classes="obsidian-metric"
                                Padding="15">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                              <TextBlock Text="GPU"
                                         Classes="kicker"
                                         FontSize="8" />
                              <TextBlock Text="{Binding Telemetry.GpuDetail}"
                                         Classes="muted"
                                         FontSize="10" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Telemetry.GpuLabel}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Border Classes="obsidian-metric"
                                Padding="15">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                              <TextBlock Text="MEMORY"
                                         Classes="kicker"
                                         FontSize="8" />
                              <TextBlock Text="Physical"
                                         Classes="muted"
                                         FontSize="10" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Telemetry.MemoryLabel}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12"
                      Margin="3,0,3,0">
                  <Border Height="1"
                          Background="{StaticResource BkeHairlineBrush}"
                          VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Content="Library &#x203A;"
                          Classes="quiet shelf-link"
                          Click="OpenLibrary"
                          VerticalAlignment="Center" />
                </Grid>

                <ItemsControl ItemsSource="{Binding DashboardProducts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"
                                 ItemWidth="136" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SoftwareProductViewModel">
                      <Button Classes="app-tile"
                              Margin="0,0,10,10"
                              Click="OpenDashboardProduct">
                        <Grid Width="126"
                              Height="104">
                          <Border Background="#5A000000"
                                  CornerRadius="16"
                                  Margin="5,7,0,0" />
                          <Border Classes="app-shelf-card"
                                  Margin="0,0,5,7"
                                  Padding="11">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="7">
                              <Grid Width="42"
                                    Height="42">
                                <Border Background="#4A000000"
                                        CornerRadius="14"
                                        Margin="4,5,0,0" />
                                <Border Width="38"
                                        Height="38"
                                        Classes="app-mark"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                  <Grid>
                                    <Ellipse Width="22"
                                             Height="22"
                                             Stroke="#355064"
                                             StrokeThickness="1" />
                                    <Ellipse Width="12"
                                             Height="12"
                                             Stroke="#4A8177FF"
                                             StrokeThickness="1" />
                                    <Border Width="5"
                                            Height="5"
                                            Classes="signal-dot"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                  </Grid>
                                </Border>
                              </Grid>
                              <TextBlock Text="{Binding DisplayName}"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         TextAlignment="Center"
                                         TextWrapping="Wrap"
                                         MaxWidth="102" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border IsVisible="{Binding ShowEmptyDashboardProducts}"
                        Classes="content-card"
                        CornerRadius="12"
                        Padding="14,12"
                        MaxWidth="460"
                        HorizontalAlignment="Left">
                  <TextBlock Text="No software is ready to open yet. Use Library to install software available to this account."
                             Classes="muted"
                             FontSize="11"
                             TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <Grid IsVisible="{Binding ShowLibraryModule}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="20"
                          Margin="2,4,12,14">
                <TextBlock Text="Library"
                           FontSize="32"
                           FontWeight="SemiBold" />

                <ItemsControl ItemsSource="{Binding Products}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"
                                 ItemWidth="450" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SoftwareProductViewModel">
                      <Grid Width="436"
                            MinHeight="210"
                            Margin="0,0,14,14">
                        <Border Background="#5A000000"
                                CornerRadius="22"
                                Margin="8,10,0,0" />
                        <Border Classes="library-card"
                                Margin="0,0,8,10"
                                Padding="19">
                          <Grid RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="14">
                              <Border Width="58"
                                      Height="58"
                                      Classes="app-mark">
                                <Grid>
                                  <Ellipse Width="30"
                                           Height="30"
                                           Stroke="#355064"
                                           StrokeThickness="1" />
                                  <Ellipse Width="17"
                                           Height="17"
                                           Stroke="#4A8177FF"
                                           StrokeThickness="1" />
                                  <Border Width="7"
                                          Height="7"
                                          Classes="signal-dot"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Grid>
                              </Border>

                              <StackPanel Grid.Column="1"
                                          Spacing="4"
                                          VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           Classes="product-title" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="7">
                                  <TextBlock Text="{Binding ExecutionLabel}"
                                             Classes="muted"
                                             FontSize="10" />
                                  <TextBlock Text="&#x00B7;"
                                             Classes="muted"
                                             FontSize="10" />
                                  <TextBlock Text="{Binding VersionLabel}"
                                             Classes="muted"
                                             FontSize="10" />
                                </StackPanel>
                              </StackPanel>

                              <Border Grid.Column="2"
                                      Classes="status-pill"
                                      Padding="9,5"
                                      VerticalAlignment="Top">
                                <TextBlock Text="{Binding StateLabel}"
                                           FontSize="9"
                                           FontWeight="SemiBold" />
                              </Border>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding Summary}"
                                       Classes="muted"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,16"
                                       MaxHeight="42" />

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="7">
                              <Button Content="Install"
                                      Classes="signal"
                                      IsVisible="{Binding CanInstall}"
                                      Click="InstallProduct" />
                              <Button Content="Update"
                                      Classes="signal"
                                      IsVisible="{Binding CanUpdate}"
                                      Click="UpdateProduct" />
                              <Button Content="Repair"
                                      Classes="quiet"
                                      IsVisible="{Binding CanRepair}"
                                      Click="RepairProduct" />
                              <Button Content="Open"
                                      Classes="primary"
                                      IsVisible="{Binding CanOpen}"
                                      Click="OpenProduct" />
                              <Button Content="Remove"
                                      Classes="quiet"
                                      IsVisible="{Binding CanRemove}"
                                      Click="RemoveProduct" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border IsVisible="{Binding ShowEmptyProducts}"
                        Classes="library-card"
                        Padding="24">
                  <TextBlock Text="No software is currently available to this account."
                             Classes="muted"
                             TextAlignment="Center" />
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <Grid IsVisible="{Binding ShowNotificationsModule}">
            <Grid RowDefinitions="Auto,*" Margin="6,12,6,6">
              <!-- Header -->
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Spacing="3">
                  <TextBlock Text="UPDATES &amp; ACTIVITY"
                             Classes="eyebrow" />
                  <TextBlock Text="Updates &amp; Activity"
                             Classes="section-title"
                             FontWeight="SemiBold"
                             FontSize="22" />
                  <TextBlock Text="Authoritative BKE releases, Licensing Agent health, and account security notifications."
                             Classes="muted"
                             FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="quiet"
                        Click="CheckBkeUpdates"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Check for software and account updates">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <LucideIcon Kind="RefreshCw" Size="14" StrokeWidth="1.8" />
                    <TextBlock Text="Check updates" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Main Scrollable Content -->
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Margin="0,0,4,16">

                  <!-- 1. HERO UNIT: BKE Application Update -->
                  <Border Classes="obsidian-hero"
                          Padding="20"
                          CornerRadius="16">
                    <StackPanel Spacing="14">
                      <!-- Top row: App branding + version + status pill + channel -->
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <Border Classes="app-mark"
                                  Width="36"
                                  Height="36">
                            <TextBlock Text="BKE"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BkeDigitalYellowBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="BKE Desktop"
                                       FontWeight="SemiBold"
                                       FontSize="16" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding BkeCurrentVersion, StringFormat='Installed v{0}'}"
                                         Classes="muted"
                                         FontSize="12" />
                              <TextBlock Text="&#x2022;" Classes="muted" FontSize="12" />
                              <TextBlock Text="BKE Digital Solutions"
                                         Classes="muted"
                                         FontSize="12" />
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>

                        <!-- Right Status Pill -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <!-- Pill: Update Available -->
                          <Border IsVisible="{Binding IsBkeUpdateAvailable}"
                                  Background="{StaticResource BkeDigitalYellowBrush}"
                                  CornerRadius="999"
                                  Padding="10,4">
                            <TextBlock Text="{Binding BkeAvailableVersion, StringFormat='v{0} AVAILABLE'}"
                                       Foreground="#0A0C0F"
                                       FontWeight="Bold"
                                       FontSize="11" />
                          </Border>
                          <!-- Pill: Up to Date -->
                          <Border IsVisible="{Binding !IsBkeUpdateAvailable}"
                                  Classes="status-pill signal"
                                  Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <Border Classes="signal-dot" VerticalAlignment="Center" />
                              <TextBlock Text="UP TO DATE"
                                         Foreground="{StaticResource BkeSignalBrush}"
                                         FontWeight="SemiBold"
                                         FontSize="11" />
                            </StackPanel>
                          </Border>
                          <!-- Channel Pill -->
                          <Border Classes="status-pill" Padding="8,4">
                            <TextBlock Text="STABLE"
                                       Classes="muted"
                                       FontWeight="SemiBold"
                                       FontSize="11" />
                          </Border>
                        </StackPanel>
                      </Grid>

                      <!-- Summary / message text -->
                      <Border Background="#66000000"
                              BorderBrush="#242B35"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="14,10">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding BkeUpdateMessage}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap" />
                          <TextBlock IsVisible="{Binding IsBkeUpdateAvailable}"
                                     Text="{Binding BkeUpdateSummary}"
                                     Classes="muted"
                                     FontSize="12"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <!-- CTA Row -->
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <LucideIcon Kind="ShieldCheck"
                                      Size="15"
                                      StrokeWidth="1.8"
                                      Foreground="{StaticResource BkeSignalBrush}" />
                          <TextBlock Text="Verified publisher: BKE Digital Solutions &#x2022; Windows x64"
                                     Classes="muted"
                                     FontSize="11"
                                     VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Action Button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                          <Button IsVisible="{Binding IsBkeUpdateAvailable}"
                                  Content="Update BKE"
                                  Classes="yellow-cta"
                                  Click="UpdateBke"
                                  IsEnabled="{Binding !IsUpdatingBke}" />
                          <Button IsVisible="{Binding !IsBkeUpdateAvailable}"
                                  Content="Check for updates"
                                  Click="CheckBkeUpdates" />
                        </StackPanel>
                      </Grid>

                      <!-- Progress bar when updating -->
                      <ProgressBar IsVisible="{Binding IsUpdatingBke}"
                                   IsIndeterminate="True"
                                   Height="4"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource BkeDigitalYellowBrush}" />
                    </StackPanel>
                  </Border>

                  <!-- 2. LICENSING AGENT COMPONENT SECTION -->
                  <Border Classes="machine-card"
                          Padding="16"
                          CornerRadius="14">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="Licensing Agent Component"
                                     FontWeight="SemiBold"
                                     FontSize="14" />
                          <Border Background="#1667D9FF"
                                  BorderBrush="#4767D9FF"
                                  BorderThickness="1"
                                  CornerRadius="999"
                                  Padding="7,2">
                            <TextBlock Text="MACHINE TRUST BOUNDARY"
                                       Foreground="{StaticResource BkeSignalBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="Local Windows Service manages lease custody, hardware machine challenge, and isolated execution."
                                   Classes="muted"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Width="7" Height="7" CornerRadius="999" Background="{StaticResource BkeSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AgentServiceStatus, StringFormat='Status: {0}'}" FontSize="11" Classes="muted" />
                          </StackPanel>
                          <TextBlock Text="{Binding AgentServiceVersion, StringFormat='Version: v{0}'}" FontSize="11" Classes="muted" />
                          <TextBlock Text="Endpoint: http://127.0.0.1:43873/" FontSize="11" Classes="muted" />
                        </StackPanel>
                      </StackPanel>

                      <Border Grid.Column="1"
                              Classes="status-pill signal"
                              Padding="10,6"
                              VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <LucideIcon Kind="Check" Size="14" StrokeWidth="2" Foreground="{StaticResource BkeSignalBrush}" />
                          <TextBlock Text="VERIFIED LOCAL"
                                     FontSize="11"
                                     FontWeight="Bold"
                                     Foreground="{StaticResource BkeSignalBrush}" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>

                  <!-- 3. PRODUCT UPDATES SECTION -->
                  <Border Classes="content-card"
                          Padding="16"
                          CornerRadius="14">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="Installed Product Updates"
                                     FontWeight="SemiBold"
                                     FontSize="14" />
                          <TextBlock Text="Application updates managed via Licensing Agent."
                                     Classes="muted"
                                     FontSize="12" />
                        </StackPanel>
                      </Grid>

                      <!-- List of products that can update -->
                      <ItemsControl ItemsSource="{Binding ProductUpdates}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SoftwareProductViewModel">
                            <Border Classes="content-card"
                                    Background="#0E1217"
                                    Padding="12"
                                    CornerRadius="10"
                                    Margin="0,0,0,6">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                  <TextBlock Text="{Binding DisplayName}"
                                             FontWeight="SemiBold"
                                             FontSize="14" />
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding VersionLabel}"
                                               Classes="muted"
                                               FontSize="11" />
                                    <TextBlock Text="{Binding AvailableVersion, StringFormat='&#x2794; Available: v{0}'}"
                                               Foreground="{StaticResource BkeDigitalYellowBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="11" />
                                  </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Update"
                                        Classes="yellow-cta"
                                        Click="UpdateProduct"
                                        VerticalAlignment="Center" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- If no product updates -->
                      <Border IsVisible="{Binding !HasProductUpdates}"
                              Background="#55000000"
                              Padding="12"
                              CornerRadius="8">
                        <TextBlock Text="All installed software products are up to date."
                                   Classes="muted"
                                   FontSize="12"
                                   TextAlignment="Center" />
                      </Border>
                    </StackPanel>
                  </Border>

                  <!-- 4. ACCOUNT ACTIVITY & NOTIFICATIONS SECTION -->
                  <Border Classes="content-card"
                          Padding="16"
                          CornerRadius="14">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="Account Activity &amp; Alerts"
                                     FontWeight="SemiBold"
                                     FontSize="14" />
                          <TextBlock Text="Signed release events and account communications"
                                     Classes="muted"
                                     FontSize="12" />
                        </StackPanel>
                        <Border IsVisible="{Binding !ShowEmptyNotifications}"
                                Classes="status-pill"
                                Padding="8,3"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding Notifications.Count, StringFormat='{}{0} items'}"
                                     Classes="muted"
                                     FontSize="11"
                                     FontWeight="SemiBold" />
                        </Border>
                      </Grid>

                      <ItemsControl ItemsSource="{Binding Notifications}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:NotificationViewModel">
                            <Border Classes="content-card"
                                    Background="#0E1217"
                                    Padding="14"
                                    CornerRadius="10"
                                    Margin="0,0,0,8">
                              <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock Text="{Binding Title}"
                                             FontWeight="SemiBold"
                                             FontSize="14"
                                             TextWrapping="Wrap" />
                                  <Border Grid.Column="1"
                                          Background="#15FFFFFF"
                                          CornerRadius="4"
                                          Padding="6,2">
                                    <TextBlock Text="{Binding StateLabel}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                  </Border>
                                </Grid>
                                <TextBlock Text="{Binding Body}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Opacity="0.85" />
                                <WrapPanel Margin="0,2,0,0">
                                  <TextBlock Text="{Binding CategoryLabel}"
                                             FontSize="11"
                                             Classes="muted"
                                             Margin="0,0,12,0" />
                                  <TextBlock Text="{Binding SeverityLabel}"
                                             FontSize="11"
                                             Classes="muted"
                                             Margin="0,0,12,0" />
                                  <TextBlock Text="{Binding ProductLabel}"
                                             FontSize="11"
                                             Classes="muted"
                                             Margin="0,0,12,0" />
                                  <TextBlock Text="{Binding CreatedLabel}"
                                             FontSize="11"
                                             Classes="muted" />
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,6,0,0">
                                  <Button Content="Mark read"
                                          Click="MarkNotificationRead"
                                          IsVisible="{Binding CanMarkRead}"
                                          Padding="10,4"
                                          MinHeight="28"
                                          FontSize="12" />
                                  <Button Content="Dismiss"
                                          Classes="quiet"
                                          Click="DismissNotification"
                                          Padding="10,4"
                                          MinHeight="28"
                                          FontSize="12" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Border IsVisible="{Binding ShowEmptyNotifications}"
                              Background="#55000000"
                              Padding="16"
                              CornerRadius="8">
                        <TextBlock Text="No account notifications or alerts."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Classes="muted"
                                   FontSize="12" />
                      </Border>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>

          <Grid IsVisible="{Binding ShowStoreModule}">
            <Grid RowDefinitions="Auto,Auto,*" Margin="4,14,4,4">
              <StackPanel Spacing="3">
                <TextBlock Text="Store" Classes="section-title" />
                <TextBlock Text="{Binding StoreMessage}" TextWrapping="Wrap" Opacity="0.72" />
              </StackPanel>

              <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,14">
                <TextBlock Text="{Binding GiftCheckoutLabel}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock Text="Plans and prices are catalog presentation only in this pre-production build. Secure checkout authority remains with BKE Digital Solutions."
                           TextWrapping="Wrap"
                           Opacity="0.62" />
                <Border IsVisible="{Binding ShowStoreTrialState}"
                        Classes="content-card"
                        Padding="12"
                        CornerRadius="8"
                        Margin="0,8,0,0">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Free trial"
                                 FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding StoreTrialStatus}"
                                 FontSize="11"
                                 FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="{Binding StoreTrialMessage}"
                               TextWrapping="Wrap"
                               Opacity="0.78" />
                    <Button Content="Refresh trial state"
                            Click="RefreshStoreTrialState"
                            IsVisible="{Binding CanRefreshStoreTrialState}" />
                    <TextBlock Text="When a trial-start result is unknown, BKE blocks another trial mutation until account purchases and My Software are refreshed through the Licensing Agent."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Opacity="0.62" />
                  </StackPanel>
                </Border>

                <Border IsVisible="{Binding ShowPurchaseReview}"
                        Classes="content-card"
                        Padding="12"
                        CornerRadius="8"
                        Margin="0,8,0,0">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Purchase review" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding PurchaseReviewStatus}"
                                 FontSize="11"
                                 FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="{Binding PurchaseReviewMessage}"
                               TextWrapping="Wrap"
                               Opacity="0.78" />
                    <TextBlock Text="{Binding PurchaseReviewProductLabel}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PurchaseReviewEditionLabel}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PurchaseReviewPriceLabel}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PurchaseReviewModesLabel}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PurchaseReviewLegalLabel}"
                               TextWrapping="Wrap"
                               Opacity="0.78" />
                    <TextBlock Text="Review only &#x2014; no order, payment, or checkout has been created yet."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Opacity="0.62" />

                    <StackPanel IsVisible="{Binding ShowPurchaseActions}"
                                Spacing="8"
                                Margin="0,8,0,0">
                      <TextBlock Text="Required Legal documents"
                                 FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding PurchaseLegalDocuments}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PurchaseLegalDocumentViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,2">
                              <CheckBox Content="{Binding Label}"
                                        IsChecked="{Binding IsAccepted, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                              <Button Grid.Column="1"
                                      Content="Open"
                                      Click="OpenPurchaseLegalDocument" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="SELF binds the paid software right to this signed-in account. GIFT creates an unbound one-time Claim Code after confirmed payment."
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Opacity="0.72" />

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Buy for myself"
                                Click="BuyForSelf"
                                IsEnabled="{Binding CanBuySelf}" />
                        <Button Content="Buy as gift / Claim Code"
                                Click="BuyAsGift"
                                IsEnabled="{Binding CanBuyGift}" />
                      </StackPanel>

                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowPurchaseCheckoutState}"
                                Spacing="8"
                                Margin="0,8,0,0">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding PurchaseCheckoutMessage}"
                                   TextWrapping="Wrap"
                                   Opacity="0.78" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PurchaseCheckoutStatus}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                      </Grid>

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Check checkout status"
                                Click="CheckPurchaseCheckoutStatus"
                                IsEnabled="{Binding CanCheckCheckoutStatus}" />
                        <Button Content="Resume original checkout"
                                Click="RetryOriginalCheckout"
                                IsEnabled="{Binding CanRetryOriginalCheckout}" />
                        <Button Content="Open existing checkout"
                                Click="OpenExistingCheckout"
                                IsEnabled="{Binding CanOpenExistingCheckout}" />
                      </StackPanel>

                      <Border IsVisible="{Binding HasGiftClaimCode}"
                                Classes="content-card"
                              Padding="12"
                              CornerRadius="8">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Gift Claim Code"
                                     FontWeight="SemiBold" />
                          <TextBox Text="{Binding GiftClaimCode, Mode=OneWay}"
                                   IsReadOnly="True"
                                   TextWrapping="Wrap" />
                          <TextBlock Text="This is an unbound one-time Claim Code. Send it to the intended recipient; the first eligible BKE account that successfully redeems it becomes the software owner. BKE Launcher keeps this plaintext in memory only."
                                     TextWrapping="Wrap"
                                     FontSize="11"
                                     Opacity="0.72" />
                          <Button Content="I've saved this Claim Code"
                                  Click="CompleteGiftClaimDelivery"
                                  IsEnabled="{Binding CanCompleteGiftDelivery}" />
                        </StackPanel>
                      </Border>

                      <TextBlock Text="Checkout-status recovery is read-only. It checks the existing correlation and never creates a second order or payment."
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Opacity="0.62" />
                      <TextBlock Text="Secure payment opens from a Digital Solutions-created checkout target. BKE never chooses the price, payment provider, destination account, or gift recipient."
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Opacity="0.62" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <ItemsControl ItemsSource="{Binding StoreProducts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StoreProductViewModel">
                        <Border Classes="content-card" Padding="14" CornerRadius="10" Margin="0,0,0,8">
                          <StackPanel Spacing="8">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.78" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.62" />

                            <ItemsControl ItemsSource="{Binding Editions}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StoreEditionViewModel">
                                  <Border Classes="content-card" Padding="12" CornerRadius="8" Margin="0,4,0,4">
                                    <StackPanel Spacing="5">
                                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.72" />
                                      <TextBlock Text="{Binding UsageLabel}" TextWrapping="Wrap" FontSize="11" Opacity="0.68" />
                                      <TextBlock Text="{Binding FeatureSummary}" TextWrapping="Wrap" FontSize="11" Opacity="0.68" />

                                      <StackPanel Orientation="Horizontal"
                                                  Spacing="8"
                                                  Margin="0,4,0,2">
                                        <Button Content="Start free 7-day trial"
                                                Click="StartStoreTrial" />
                                        <TextBlock Text="One self-service trial per product/account/calendar year."
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Opacity="0.68" />
                                      </StackPanel>

                                      <ItemsControl ItemsSource="{Binding Plans}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="vm:StorePlanViewModel">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                              <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DetailLabel}" FontSize="11" Opacity="0.68" />
                                              </StackPanel>
                                              <StackPanel Grid.Column="1"
                                                          Spacing="6"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PriceLabel}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" />
                                                <Button Content="Review purchase"
                                                        Click="ReviewPurchase" />
                                              </StackPanel>
                                            </Grid>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border IsVisible="{Binding ShowEmptyStore}" Classes="content-card" Padding="18" CornerRadius="10">
                    <TextBlock Text="No purchasable products are currently available."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Opacity="0.68" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>


    <Border Height="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="Transparent"
            WindowDecorationProperties.ElementRole="ResizeN" />
    <Border Height="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="Transparent"
            WindowDecorationProperties.ElementRole="ResizeS" />
    <Border Width="6"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="Transparent"
            WindowDecorationProperties.ElementRole="ResizeW" />
    <Border Width="6"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="Transparent"
            WindowDecorationProperties.ElementRole="ResizeE" />

    <Border Width="10"
            Height="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            WindowDecorationProperties.ElementRole="ResizeNW" />
    <Border Width="10"
            Height="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent"
            WindowDecorationProperties.ElementRole="ResizeNE" />
    <Border Width="10"
            Height="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="Transparent"
            WindowDecorationProperties.ElementRole="ResizeSW" />
    <Border Width="10"
            Height="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            WindowDecorationProperties.ElementRole="ResizeSE" />
    <Grid Height="26"
          Margin="6,6,6,0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Top"
          ColumnDefinitions="*,Auto">
      <Border Background="Transparent"
              WindowDecorationProperties.ElementRole="TitleBar" />
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="2"
                  VerticalAlignment="Top">
        <Button Classes="window-control"
                ToolTip.Tip="Minimize"
                WindowDecorationProperties.ElementRole="MinimizeButton"
                Click="MinimizeWindow">
          <LucideIcon Kind="Minus"
                      Size="14"
                      StrokeWidth="1.8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        </Button>
        <Button Classes="window-control"
                ToolTip.Tip="Maximize or restore"
                WindowDecorationProperties.ElementRole="MaximizeButton"
                Click="ToggleMaximizeWindow">
          <LucideIcon Kind="Square"
                      Size="13"
                      StrokeWidth="1.7"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        </Button>
        <Button Classes="window-control window-close"
                ToolTip.Tip="Close BKE"
                WindowDecorationProperties.ElementRole="CloseButton"
                Click="CloseWindow">
          <LucideIcon Kind="X"
                      Size="14"
                      StrokeWidth="1.8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
